{
  "name": "zeta",
  "displayName": "zeta",
  "version": "1.5.0",
  "icon": "./public/icon.png",
  "description": "A modern toolkit for VS Code.",
  "categories": [
    "Other"
  ],
  "repository": "https://github.com/lo0kie/zeta",
  "license": "MIT",
  "author": "lo0kie",
  "publisher": "lo0kie",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsup src/index.ts --watch --external vscode",
    "build": "tsup src/index.ts --minify --external vscode",
    "generate-code": "node ./generate_all_code.cjs",
    "package": "pnpm build && vsce package --no-dependencies",
    "format": "prettier \"src/**/*.{js,ts}\" -w -u --cache"
  },
  "contributes": {
    "commands": [
      {
        "command": "zeta.file.openInBrowser",
        "title": "在默认浏览器打开",
        "icon": "$(globe)",
        "category": "zeta"
      },
      {
        "command": "zeta.folder.openInWindow",
        "title": "在当前窗口中打开",
        "icon": "$(folder)",
        "category": "zeta"
      },
      {
        "command": "zeta.folder.openInNewWindow",
        "title": "在新窗口中打开",
        "icon": "$(link-external)",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.wrapTags",
        "title": "插入标签",
        "category": "zeta"
      },
      {
        "command": "zeta.folder.openInTerminal",
        "title": "在终端打开",
        "icon": "$(terminal)",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.changeCase",
        "title": "修改单词格式",
        "category": "zeta"
      },
      {
        "command": "zeta.folder.runScript",
        "title": "查找脚本运行",
        "icon": "$(package)",
        "category": "zeta"
      },
      {
        "command": "zeta.explorer.refresh",
        "title": "刷新视图",
        "icon": "$(refresh)",
        "category": "zeta"
      },
      {
        "command": "zeta.explorer.addFolder",
        "title": "添加检索目录",
        "icon": "$(new-folder)",
        "category": "zeta"
      },
      {
        "command": "zeta.terminal.toggle",
        "title": "切换终端显示",
        "icon": "$(terminal)",
        "category": "zeta"
      },
      {
        "command": "zeta.explorer.removeFolder",
        "title": "从导航中移除",
        "icon": "$(trash)",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.cycleCase",
        "title": "循环切换单词格式",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.wrapConsole",
        "title": "包裹为 console.log",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.wrapTryCatch",
        "title": "包裹为 try/catch",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.wrapIf",
        "title": "包裹为 if 语句",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.unwrapTags",
        "title": "移除外层标签",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.cycleQuotes",
        "title": "切换引号 (' / \" / `)",
        "category": "zeta"
      }
    ],
    "configuration": {
      "title": "zeta",
      "properties": {
        "zeta.string.tag": {
          "type": "string",
          "description": "插入标签时填充的标签",
          "default": "div"
        },
        "zeta.case.custom": {
          "type": "object",
          "description": "自定义单词转换格式：键为格式名，值为转换步骤数组，每步依次执行 pattern(正则) -> replacement(替换串，支持 $1 等捕获组)，flags 默认 g",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pattern",
                "replacement"
              ],
              "properties": {
                "pattern": {
                  "type": "string",
                  "description": "正则表达式"
                },
                "replacement": {
                  "type": "string",
                  "description": "替换串，支持 $1、$<name> 等"
                },
                "flags": {
                  "type": "string",
                  "description": "正则 flags，默认 g",
                  "default": "g"
                }
              }
            }
          }
        },
        "zeta.list.folders": {
          "type": "array",
          "description": "explorer需要检索的目录",
          "items": {
            "type": "string",
            "uniqueItems": true
          },
          "default": []
        },
        "zeta.list.filterFolders": {
          "type": "array",
          "description": "explorer中过滤的关键字",
          "items": {
            "type": "string",
            "uniqueItems": true
          },
          "default": [
            "node_modules",
            ".vscode",
            ".git",
            ".svn"
          ]
        },
        "zeta.show.explorer": {
          "type": "boolean",
          "description": "是否显示资源导航",
          "default": true
        },
        "zeta.show.terminal": {
          "type": "boolean",
          "description": "是否显示状态栏终端切换按钮",
          "default": true
        }
      }
    },
    "keybindings": [
      {
        "key": "alt+shift+w",
        "command": "zeta.editor.wrapTags",
        "when": "editorIsOpen && editorLangId =~ /^(vue|html|javascriptreact|typescriptreact)$/ && !editorReadonly"
      },
      {
        "key": "ctrl+alt+shift+r",
        "command": "zeta.folder.runScript",
        "when": "workspaceFolderCount > 0 && resourceScheme != git && resourceScheme != untitled"
      },
      {
        "key": "alt+shift+e",
        "command": "zeta.editor.changeCase",
        "when": "editorHasSelection && !editorReadonly"
      },
      {
        "key": "alt+shift+c",
        "command": "zeta.editor.cycleCase",
        "when": "editorIsOpen && !editorReadonly && editorHasSelection"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zeta.explorer.refresh",
          "group": "navigation@0",
          "when": "view == zeta-explorer"
        },
        {
          "command": "zeta.explorer.addFolder",
          "group": "navigation@1",
          "when": "view == zeta-explorer"
        }
      ],
      "view/item/context": [
        {
          "command": "zeta.file.openInBrowser",
          "group": "navigation@3",
          "when": "viewItem =~ /file-.*\\.html?$/"
        },
        {
          "command": "zeta.folder.openInWindow",
          "group": "inline@1",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.folder.openInNewWindow",
          "group": "inline@2",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.folder.openInTerminal",
          "group": "inline@0",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.folder.openInNewWindow",
          "group": "navigation@0",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.folder.openInWindow",
          "group": "navigation@1",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.explorer.removeFolder",
          "group": "navigation@2",
          "when": "view == zeta-explorer && viewItem =~ /^directory-root-/"
        }
      ],
      "editor/title": [
        {
          "command": "zeta.file.openInBrowser",
          "group": "navigation@1",
          "when": "editorLangId in zeta.htmlId && resourceScheme != untitled"
        }
      ],
      "explorer/context": [
        {
          "command": "zeta.file.openInBrowser",
          "group": "navigation@0",
          "when": "resourceLangId in zeta.htmlId"
        }
      ],
      "editor/context": [
        {
          "command": "zeta.file.openInBrowser",
          "group": "navigation@0",
          "when": "editorLangId in zeta.htmlId && resourceScheme != untitled"
        }
      ],
      "commandPalette": [
        {
          "command": "zeta.explorer.refresh",
          "when": "false"
        },
        {
          "command": "zeta.editor.wrapTags",
          "when": "editorIsOpen && editorLangId =~ /^(vue|html|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.folder.openInWindow",
          "when": "false"
        },
        {
          "command": "zeta.folder.openInNewWindow",
          "when": "false"
        },
        {
          "command": "zeta.editor.changeCase",
          "when": "editorHasSelection && !editorReadonly"
        },
        {
          "command": "zeta.folder.runScript",
          "when": "workspaceFolderCount > 0 && resourceScheme != git && resourceScheme != untitled"
        },
        {
          "command": "zeta.folder.openInTerminal",
          "when": "false"
        },
        {
          "command": "zeta.file.openInBrowser",
          "when": "editorIsOpen && editorLangId in zeta.htmlId && resourceScheme != untitled"
        },
        {
          "command": "zeta.explorer.removeFolder",
          "when": "false"
        },
        {
          "command": "zeta.explorer.addFolder",
          "when": "config.zeta.show.explorer"
        },
        {
          "command": "zeta.editor.cycleCase",
          "when": "editorIsOpen && !editorReadonly && editorHasSelection"
        },
        {
          "command": "zeta.editor.wrapConsole",
          "when": "editorIsOpen && editorLangId =~ /^(vue|javascript|typescript|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.editor.wrapTryCatch",
          "when": "editorIsOpen && editorLangId =~ /^(vue|javascript|typescript|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.editor.wrapIf",
          "when": "editorIsOpen && editorLangId =~ /^(vue|javascript|typescript|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.editor.unwrapTags",
          "when": "editorIsOpen && editorLangId =~ /^(vue|html|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.editor.cycleQuotes",
          "when": "editorIsOpen && editorLangId =~ /^(vue|javascript|typescript|javascriptreact|typescriptreact)$/ && !editorReadonly"
        }
      ]
    },
    "views": {
      "zeta-view": [
        {
          "id": "zeta-explorer",
          "name": "资源导航",
          "contextualTitle": "Zeta 资源导航",
          "when": "config.zeta.show.explorer",
          "icon": "$(files)",
          "type": "tree"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zeta-view",
          "title": "Zeta 资源导航",
          "icon": "$(root-folder)"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "20",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "prettier": "^3.2.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "vscode": "^1.85.0"
  }
}
