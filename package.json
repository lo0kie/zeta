{
  "name": "lookie-zeta",
  "displayName": "zeta",
  "version": "1.6.0",
  "icon": "./public/icon.png",
  "description": "开发工具集：资源导航、标签与结构操作、命名格式转换、路径/样式补全与跳转、颜色编辑、脚本运行。无遥测、纯本地处理。",
  "categories": [
    "Other"
  ],
  "keywords": [
    "path completion",
    "style completion",
    "scss",
    "less",
    "color picker",
    "rename",
    "tags",
    "case conversion",
    "terminal",
    "workspace",
    "productivity",
    "vue",
    "html"
  ],
  "repository": "https://github.com/lo0kie/zeta",
  "license": "MIT",
  "author": "lookie",
  "publisher": "lookie",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepackage": "node ./compress-images.mjs",
    "vscode:prepublish": "pnpm build",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run -c vitest.perf.config.mts",
    "typecheck": "tsc --noEmit",
    "format": "prettier \"src/**/*.{js,ts,vue}\" \"test/**/*.{js,ts}\" -w --cache",
    "format:check": "prettier \"src/**/*.{js,ts,vue}\" \"test/**/*.{js,ts}\" --check --cache",
    "generate-code": "node ./generate-all-code.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "zeta.file.openInBrowser",
        "title": "在默认浏览器打开",
        "icon": "$(globe)",
        "category": "zeta"
      },
      {
        "command": "zeta.folder.openInWindow",
        "title": "在当前窗口中打开",
        "icon": "$(folder)",
        "category": "zeta"
      },
      {
        "command": "zeta.folder.openInNewWindow",
        "title": "在新窗口中打开",
        "icon": "$(link-external)",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.wrapTags",
        "title": "插入标签",
        "category": "zeta"
      },
      {
        "command": "zeta.folder.openInTerminal",
        "title": "在终端打开",
        "icon": "$(terminal)",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.changeCase",
        "title": "修改单词格式",
        "category": "zeta"
      },
      {
        "command": "zeta.folder.runScript",
        "title": "查找脚本运行",
        "icon": "$(package)",
        "category": "zeta"
      },
      {
        "command": "zeta.explorer.refresh",
        "title": "刷新视图",
        "icon": "$(refresh)",
        "category": "zeta"
      },
      {
        "command": "zeta.explorer.addFolder",
        "title": "添加检索目录",
        "icon": "$(new-folder)",
        "category": "zeta"
      },
      {
        "command": "zeta.terminal.toggle",
        "title": "切换终端显示",
        "icon": "$(terminal)",
        "category": "zeta"
      },
      {
        "command": "zeta.explorer.removeFolder",
        "title": "从导航中移除",
        "icon": "$(trash)",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.cycleCase",
        "title": "循环切换单词格式",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.wrapConsole",
        "title": "包裹为 console.log",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.wrapTryCatch",
        "title": "包裹为 try/catch",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.wrapIf",
        "title": "包裹为 if 语句",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.unwrapTags",
        "title": "移除外层标签",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.cycleQuotes",
        "title": "切换引号 (' / \" / `)",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.debugResolveImport",
        "title": "调试导入解析",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.selectString",
        "title": "选中当前字符串",
        "category": "zeta"
      },
      {
        "command": "zeta.editor.selectBlock",
        "title": "选中当前块",
        "category": "zeta"
      },
      {
        "command": "zeta.showCommands",
        "title": "显示全部命令",
        "category": "zeta"
      },
      {
        "command": "zeta.openResolvedImport",
        "title": "打开解析的导入文件",
        "category": "zeta"
      }
    ],
    "configuration": {
      "title": "zeta",
      "properties": {
        "zeta.string.tag": {
          "type": "string",
          "description": "插入标签时填充的标签",
          "default": "div"
        },
        "zeta.case.custom": {
          "type": "object",
          "description": "自定义单词转换格式：键为格式名，值为转换步骤数组，每步依次执行 pattern(正则) -> replacement(替换串，支持 $1 等捕获组)，flags 默认 g",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pattern",
                "replacement"
              ],
              "properties": {
                "pattern": {
                  "type": "string",
                  "description": "正则表达式"
                },
                "replacement": {
                  "type": "string",
                  "description": "替换串，支持 $1、$<name> 等"
                },
                "flags": {
                  "type": "string",
                  "description": "正则 flags，默认 g",
                  "default": "g"
                }
              }
            }
          }
        },
        "zeta.case.cycleOrder": {
          "type": "array",
          "description": "循环切换单词格式（Alt+Shift+C）的转换顺序，格式名来自内置格式或 zeta.case.custom",
          "items": {
            "type": "string"
          },
          "default": [
            "Camel Case",
            "Kebab Case",
            "Pascal Case",
            "Snake Case",
            "Constant Case"
          ]
        },
        "zeta.list.folders": {
          "type": "array",
          "description": "资源导航根目录；绝对路径或相对第一个工作区根的相对路径",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "zeta.list.filterFolders": {
          "type": "array",
          "description": "资源导航中过滤的目录名关键字",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [
            "node_modules",
            ".vscode",
            ".git",
            ".svn"
          ]
        },
        "zeta.show.explorer": {
          "type": "boolean",
          "description": "是否显示资源导航",
          "default": true
        },
        "zeta.show.terminal": {
          "type": "boolean",
          "description": "是否显示状态栏终端切换按钮",
          "default": true
        },
        "zeta.runScript.askArguments": {
          "type": "boolean",
          "description": "运行脚本前是否询问追加参数（如 --watch）；关闭后选中脚本直接运行",
          "default": true
        },
        "zeta.path.extensions": {
          "type": "array",
          "description": "路径跳转/补全时尝试的文件后缀顺序（带点，如 \".ts\"）；同名不同后缀会按此顺序全部列出供选择",
          "items": {
            "type": "string"
          },
          "default": [
            ".ts",
            ".js",
            ".vue",
            ".tsx",
            ".jsx",
            ".json",
            ".css",
            ".less",
            ".scss",
            ".sass",
            ".styl",
            ".stylus"
          ]
        },
        "zeta.path.maxCompletionEntries": {
          "type": "number",
          "description": "路径补全单个目录的候选上限，超出按目录优先截断（避免超大目录拖慢渲染）",
          "default": 200
        },
        "zeta.path.showHiddenFiles": {
          "type": "boolean",
          "description": "路径补全是否显示以 . 开头的隐藏文件/目录",
          "default": false
        },
        "zeta.style.maxImportDepth": {
          "type": "number",
          "description": "样式补全/悬浮/跳转对 @import/@use/@forward 的递归展开深度上限（防循环与膨胀）",
          "default": 3
        }
      }
    },
    "keybindings": [
      {
        "key": "alt+shift+w",
        "command": "zeta.editor.wrapTags",
        "when": "editorIsOpen && editorLangId =~ /^(vue|html|javascriptreact|typescriptreact)$/ && !editorReadonly"
      },
      {
        "key": "ctrl+alt+shift+r",
        "command": "zeta.folder.runScript",
        "when": "workspaceFolderCount > 0 && resourceScheme != git && resourceScheme != untitled"
      },
      {
        "key": "alt+shift+e",
        "command": "zeta.editor.changeCase",
        "when": "editorHasSelection && !editorReadonly && !zeta.caseDisabled"
      },
      {
        "key": "alt+shift+c",
        "command": "zeta.editor.cycleCase",
        "when": "editorIsOpen && !editorReadonly && editorHasSelection && !zeta.caseDisabled"
      },
      {
        "key": "alt+shift+s",
        "command": "zeta.editor.selectString",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zeta.explorer.refresh",
          "group": "navigation@0",
          "when": "view == zeta-explorer"
        },
        {
          "command": "zeta.explorer.addFolder",
          "group": "navigation@1",
          "when": "view == zeta-explorer"
        }
      ],
      "view/item/context": [
        {
          "command": "zeta.file.openInBrowser",
          "group": "navigation@3",
          "when": "viewItem =~ /file-.*\\.html?$/"
        },
        {
          "command": "zeta.folder.openInWindow",
          "group": "inline@1",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.folder.openInNewWindow",
          "group": "inline@2",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.folder.openInTerminal",
          "group": "inline@0",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.folder.openInTerminal",
          "group": "navigation@0",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.folder.openInWindow",
          "group": "navigation@1",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.folder.openInNewWindow",
          "group": "navigation@2",
          "when": "view == zeta-explorer && viewItem =~ /^directory-/"
        },
        {
          "command": "zeta.explorer.removeFolder",
          "group": "navigation@3",
          "when": "view == zeta-explorer && viewItem =~ /^directory-root-/"
        }
      ],
      "editor/title": [
        {
          "command": "zeta.file.openInBrowser",
          "group": "navigation@1",
          "when": "editorLangId in zeta.htmlId && resourceScheme != untitled"
        }
      ],
      "explorer/context": [
        {
          "command": "zeta.file.openInBrowser",
          "group": "navigation@0",
          "when": "resourceLangId in zeta.htmlId"
        }
      ],
      "editor/context": [
        {
          "command": "zeta.file.openInBrowser",
          "group": "navigation@0",
          "when": "editorLangId in zeta.htmlId && resourceScheme != untitled"
        }
      ],
      "commandPalette": [
        {
          "command": "zeta.openResolvedImport",
          "when": "false"
        },
        {
          "command": "zeta.explorer.refresh",
          "when": "false"
        },
        {
          "command": "zeta.editor.wrapTags",
          "when": "editorIsOpen && editorLangId =~ /^(vue|html|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.folder.openInWindow",
          "when": "false"
        },
        {
          "command": "zeta.folder.openInNewWindow",
          "when": "false"
        },
        {
          "command": "zeta.editor.changeCase",
          "when": "editorHasSelection && !editorReadonly && !zeta.caseDisabled"
        },
        {
          "command": "zeta.folder.runScript",
          "when": "workspaceFolderCount > 0 && resourceScheme != git && resourceScheme != untitled"
        },
        {
          "command": "zeta.folder.openInTerminal",
          "when": "false"
        },
        {
          "command": "zeta.file.openInBrowser",
          "when": "editorIsOpen && editorLangId in zeta.htmlId && resourceScheme != untitled"
        },
        {
          "command": "zeta.explorer.removeFolder",
          "when": "false"
        },
        {
          "command": "zeta.explorer.addFolder",
          "when": "config.zeta.show.explorer"
        },
        {
          "command": "zeta.terminal.toggle",
          "when": "config.zeta.show.terminal"
        },
        {
          "command": "zeta.editor.cycleCase",
          "when": "editorIsOpen && !editorReadonly && editorHasSelection && !zeta.caseDisabled"
        },
        {
          "command": "zeta.editor.wrapConsole",
          "when": "editorIsOpen && editorLangId =~ /^(vue|javascript|typescript|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.editor.wrapTryCatch",
          "when": "editorIsOpen && editorLangId =~ /^(vue|javascript|typescript|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.editor.wrapIf",
          "when": "editorIsOpen && editorLangId =~ /^(vue|javascript|typescript|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.editor.unwrapTags",
          "when": "editorIsOpen && editorLangId =~ /^(vue|html|javascriptreact|typescriptreact)$/ && !editorReadonly"
        },
        {
          "command": "zeta.editor.cycleQuotes",
          "when": "editorIsOpen && editorLangId =~ /^(vue|javascript|typescript|javascriptreact|typescriptreact)$/ && !editorReadonly && !zeta.caseDisabled"
        },
        {
          "command": "zeta.editor.debugResolveImport",
          "when": "editorIsOpen && editorLangId =~ /^(javascript|typescript|javascriptreact|typescriptreact|vue|html|css|less|scss|sass|stylus|json)$/"
        },
        {
          "command": "zeta.editor.selectString",
          "when": "editorIsOpen && !editorReadonly"
        }
      ]
    },
    "views": {
      "zeta-view": [
        {
          "id": "zeta-explorer",
          "name": "资源导航",
          "contextualTitle": "Zeta 资源导航",
          "when": "config.zeta.show.explorer",
          "icon": "$(files)",
          "type": "tree"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zeta-view",
          "title": "Zeta 资源导航",
          "icon": "$(root-folder)"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:less",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:stylus",
    "onLanguage:styluslang",
    "onLanguage:vue",
    "onLanguage:html",
    "onLanguage:htm",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:json"
  ],
  "devDependencies": {
    "@types/culori": "4.0.1",
    "@types/node": "20",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.7",
    "prettier": "^3.2.4",
    "sharp": "^0.35.3",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "dependencies": {
    "culori": "^4.0.2"
  }
}
